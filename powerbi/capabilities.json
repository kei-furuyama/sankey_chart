{
  "dataRoles": [
    {
      "name": "source",
      "kind": "Grouping",
      "displayName": "Source",
      "displayNameKey": "Visual_Source",
      "description": "Source node for the flow"
    },
    {
      "name": "target",
      "kind": "Grouping",
      "displayName": "Target",
      "displayNameKey": "Visual_Target",
      "description": "Target node for the flow"
    },
    {
      "name": "value",
      "kind": "Measure",
      "displayName": "Value",
      "displayNameKey": "Visual_Value",
      "description": "Flow value between source and target"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "source": { "max": 1 },
          "target": { "max": 1 },
          "value": { "max": 1 }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            { "for": { "in": "source" } },
            { "for": { "in": "target" } }
          ],
          "dataReductionAlgorithm": { "top": { "count": 10000 } }
        },
        "values": {
          "select": [
            { "bind": { "to": "value" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "nodeSettings": {
      "displayName": "Nodes",
      "displayNameKey": "Visual_Nodes",
      "properties": {
        "width": {
          "displayName": "Node Width",
          "displayNameKey": "Visual_NodeWidth",
          "type": { "numeric": true }
        },
        "padding": {
          "displayName": "Node Padding",
          "displayNameKey": "Visual_NodePadding",
          "type": { "numeric": true }
        },
        "iterations": {
          "displayName": "Layout Iterations",
          "displayNameKey": "Visual_LayoutIterations",
          "type": { "numeric": true }
        },
        "colorMode": {
          "displayName": "Color Mode",
          "displayNameKey": "Visual_NodeColorMode",
          "type": {
            "enumeration": [
              { "value": "category", "displayName": "Category Colors" },
              { "value": "single", "displayName": "Single Color" }
            ]
          }
        },
        "defaultColor": {
          "displayName": "Default Color",
          "displayNameKey": "Visual_DefaultColor",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "linkSettings": {
      "displayName": "Links",
      "displayNameKey": "Visual_Links",
      "properties": {
        "colorMode": {
          "displayName": "Color Mode",
          "displayNameKey": "Visual_ColorMode",
          "type": {
            "enumeration": [
              { "value": "source", "displayName": "Source" },
              { "value": "target", "displayName": "Target" },
              { "value": "gradient", "displayName": "Gradient" },
              { "value": "fixed", "displayName": "Fixed" }
            ]
          }
        },
        "opacity": {
          "displayName": "Opacity (%)",
          "displayNameKey": "Visual_Opacity",
          "type": { "numeric": true }
        },
        "sortMode": {
          "displayName": "Link Sort",
          "displayNameKey": "Visual_LinkSort",
          "type": {
            "enumeration": [
              { "value": "ascending", "displayName": "Ascending (minimize crossing)" },
              { "value": "descending", "displayName": "Descending" },
              { "value": "byValue", "displayName": "By Value (small to large)" },
              { "value": "byValueDesc", "displayName": "By Value (large to small)" },
              { "value": "inputOrder", "displayName": "Input Order (data sort)" },
              { "value": "none", "displayName": "None" }
            ]
          }
        }
      }
    },
    "linkLabelSettings": {
      "displayName": "Link Labels",
      "displayNameKey": "Visual_LinkLabels",
      "properties": {
        "show": {
          "displayName": "Show",
          "displayNameKey": "Visual_ShowLinkLabels",
          "type": { "bool": true }
        },
        "fontSize": {
          "displayName": "Font Size",
          "displayNameKey": "Visual_LinkLabelFontSize",
          "type": { "numeric": true }
        }
      }
    },
    "labelSettings": {
      "displayName": "Node Labels",
      "displayNameKey": "Visual_NodeLabels",
      "properties": {
        "show": {
          "displayName": "Show",
          "displayNameKey": "Visual_ShowLabels",
          "type": { "bool": true }
        },
        "fontSize": {
          "displayName": "Font Size",
          "displayNameKey": "Visual_FontSize",
          "type": { "numeric": true }
        },
        "color": {
          "displayName": "Color",
          "displayNameKey": "Visual_LabelColor",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "fontFamily": {
          "displayName": "Font",
          "displayNameKey": "Visual_LabelFontFamily",
          "type": { "formatting": { "fontFamily": true } }
        }
      }
    },
    "dataLabelSettings": {
      "displayName": "Node Data Labels",
      "displayNameKey": "Visual_NodeDataLabels",
      "properties": {
        "show": {
          "displayName": "Show",
          "displayNameKey": "Visual_ShowDataLabels",
          "type": { "bool": true }
        },
        "fontSize": {
          "displayName": "Font Size",
          "displayNameKey": "Visual_DataLabelFontSize",
          "type": { "numeric": true }
        },
        "color": {
          "displayName": "Color",
          "displayNameKey": "Visual_DataLabelColor",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "fontFamily": {
          "displayName": "Font",
          "displayNameKey": "Visual_DataLabelFontFamily",
          "type": { "formatting": { "fontFamily": true } }
        }
      }
    },
    "nodeColors": {
      "displayName": "Node Colors",
      "displayNameKey": "Visual_NodeColors",
      "properties": {
        "fill": {
          "displayName": "Color",
          "displayNameKey": "Visual_NodeColor",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "marginSettings": {
      "displayName": "Margins",
      "displayNameKey": "Visual_Margins",
      "properties": {
        "top": {
          "displayName": "Top",
          "displayNameKey": "Visual_MarginTop",
          "type": { "numeric": true }
        },
        "right": {
          "displayName": "Right",
          "displayNameKey": "Visual_MarginRight",
          "type": { "numeric": true }
        },
        "bottom": {
          "displayName": "Bottom",
          "displayNameKey": "Visual_MarginBottom",
          "type": { "numeric": true }
        },
        "left": {
          "displayName": "Left",
          "displayNameKey": "Visual_MarginLeft",
          "type": { "numeric": true }
        }
      }
    }
  },
  "privileges": [],
  "supportsHighlight": true,
  "supportsMultiVisualSelection": true,
  "supportsKeyboardFocus": true,
  "supportsLandingPage": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": ["tooltips"],
    "supportEnhancedTooltips": true
  },
  "sorting": {
    "default": {}
  }
}
