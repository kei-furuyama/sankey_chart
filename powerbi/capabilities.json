        },
        "colorMode": {
          "displayName": "Color Mode",
          "displayNameKey": "Visual_ColorMode",
          "type": {
            "enumeration": [
              { "value": "source", "displayName": "Source" },
              { "value": "target", "displayName": "Target" },
              { "value": "gradient", "displayName": "Gradient" },
              { "value": "fixed", "displayName": "Fixed" },
