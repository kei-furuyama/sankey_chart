{
  "name": "sankey-chart-powerbi",
  "version": "1.0.0",
  "description": "High-performance Sankey Chart Power BI Custom Visual",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf node_modules/.cache",
    "pbiviz:start": "cd powerbi && pbiviz start",
    "pbiviz:package": "cd powerbi && pbiviz package",
    "pbiviz:install": "npm install --prefix powerbi"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "d3-interpolate": "^3.0.1",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/d3": "^7.4.3",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.2",
    "eslint": "^8.56.0",
    "jsdom": "^27.4.0",
    "powerbi-visuals-api": "^5.9.0",
    "powerbi-visuals-tools": "^5.4.0",
    "powerbi-visuals-utils-dataviewutils": "^6.1.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
